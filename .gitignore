# Processed data (large, regenerated by scripts/build_db.py)
data/processed/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env

# Jupyter
.ipynb_checkpoints/
.cache/

# macOS
.DS_Store

# Claude Code agent worktrees
.claude/worktrees/

# Output — exports are regenerated; charts are committed alongside reports
output/exports/
output/studies/

# MkDocs generated output (built by CI)
mkdocs_out/

# mkdocs_src/courses/ and mkdocs_nav.yml are tracked and rebuilt automatically
# by the pre-commit hook (scripts/hooks/pre-commit) via build_courses.py.
# All other mkdocs_src/ subdirectories are generated by separate build scripts
# and are not committed.
mkdocs_src/lessons/
mkdocs_src/notebooks/
mkdocs_src/reports/
mkdocs_src/assets/
mkdocs_src/javascripts/
mkdocs_src/stylesheets/
mkdocs_src/study-helps/
mkdocs_src/reference/
mkdocs_src/*.md

# Student zip packages — generated by scripts/build_student_packs.py; not committed
output/student-packs/
.idea/
temp/

# Research library — vector index and manifest are machine-specific (regenerated by scripts/index_research_library.py)
data/research/.chromadb/
data/research/.index_manifest.json

# MCP server config — contains machine-specific absolute paths; each developer creates their own
.mcp.json
