#!/usr/bin/env bash
# Pre-commit hook: rebuild mkdocs_src/ sections and mkdocs_nav.yml whenever
# course/lesson data or the build scripts themselves are staged.
#
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit
#          chmod +x .git/hooks/pre-commit
set -euo pipefail

# Auto-stage any locally modified exercise PDFs so they never accumulate as
# silent unstaged changes after a full exercise_pdf rebuild.
modified_pdfs=$(git diff --name-only -- 'data/lessons/' | grep '\.pdf$' || true)
if [ -n "$modified_pdfs" ]; then
    echo "[pre-commit] Auto-staging modified exercise PDFs ..."
    echo "$modified_pdfs" | xargs git add
    echo "[pre-commit] Done (exercise PDFs staged)."
fi

# Auto-stage new or modified PDFs in data/research/, then rebuild the search index.
research_pdfs=$(
    { git diff --name-only -- 'data/research/' 2>/dev/null
      git ls-files --others --exclude-standard -- 'data/research/' 2>/dev/null; } \
    | grep '\.pdf$' | sort -u || true
)
if [ -n "$research_pdfs" ]; then
    echo "[pre-commit] Auto-staging research PDFs ..."
    echo "$research_pdfs" | xargs git add
    echo "[pre-commit] Done (research PDFs staged)."
fi
if git diff --cached --name-only | grep -qE '^data/research/.*\.pdf$'; then
    echo "[pre-commit] Rebuilding research library search index ..."
    if [ -n "${OPENAI_API_KEY:-}" ]; then
        .venv/bin/python3 scripts/index_research_library.py
        echo "[pre-commit] Done (research index)."
    else
        echo "[pre-commit] Warning: OPENAI_API_KEY not set — PDFs staged but index not rebuilt."
        echo "[pre-commit] Run: python scripts/index_research_library.py  (requires API key)"
    fi
fi

if git diff --cached --name-only | grep -qE '^(data/courses/|scripts/build_courses\.py)'; then
    echo "[pre-commit] Rebuilding mkdocs_src/courses/ ..."
    .venv/bin/python3 scripts/build_courses.py
    git add mkdocs_src/courses/ mkdocs_nav.yml
    echo "[pre-commit] Done (courses)."
fi

if git diff --cached --name-only | grep -qE '^(data/lessons/|scripts/build_lessons\.py)'; then
    echo "[pre-commit] Rebuilding mkdocs_src/lessons/ ..."
    .venv/bin/python3 scripts/build_lessons.py
    # mkdocs_src/lessons/ is gitignored (generated); only stage the nav update
    git add mkdocs_nav.yml
    echo "[pre-commit] Done (lessons)."
fi

if git diff --cached --name-only | grep -qE '^(data/studies/|scripts/build_studies\.py)'; then
    echo "[pre-commit] Rebuilding mkdocs_src/studies/ ..."
    .venv/bin/python3 scripts/build_studies.py
    git add mkdocs_src/studies/ mkdocs_nav.yml
    echo "[pre-commit] Done (studies)."
fi
